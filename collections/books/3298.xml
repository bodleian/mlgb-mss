                  <origin>
                     <origDate when-custom="0690/0710" notBefore="0690" notAfter="0710" calendar="#gregorian">s. vii/viii</origDate>
                  </origin>
                  <provenance type="#s" source="3298"><orgName role="fmo" key="mlgbOrg_274">Jarrow and
                        Monkwearmouth, Durham. Benedictine abbey of St Paul; later cell of Durham</orgName><p>Add. 37777 and Add. 45025 are fragments of one volume written
                        in the same type of uncial and in the same format as the Codex Amiatinus
                        (Florence, Laurenziana, MS. Amiatino 1), and therefore to be identified with
                        one of the two bibles written for Wearmouth-Jarrow at the time that
                        Amiatinus was written for presentation to St Peter's, Rome (Bede, Hist.
                        Abbatum, ed. Plummer, 1. 379--80). For other MSS. written in the scriptorium
                        of Wearmouth-Jarrow see E. A. Lowe, English Uncial (Oxford 1960), pp.
                        8--13.</p><p> </p></provenance>
               <provenance cert="low" source="5942"><orgName role="fmo" key="mlgbOrg_601">Worcester, Worcestershire.
                        Benedictine cathedral priory of St Mary the Virgin</orgName><p>BL. Add.
                        37777 and Add. 45025 are fragments of one volume: cf. under Jarrow and for
                        the evidence connecting this Bible with Worcester, Cat. Libr. Wigorn. ...,
                        ed. Atkins and Ker, pp. 77--79.</p></provenance>
               </history>
