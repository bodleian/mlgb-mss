                  <textLang mainLang="la">Latin</textLang>
                  <msItem>
                     <title>Gregorius</title>
                     <note type="MLGB3_generalNotes">No old flyleaves. Stylus ruling; 2 columns, 43
                        lines.</note>
                     <note type="MLGB3_generalNotes">Part of the eleven-volume set from which come
                        the five manuscripts that are now Chicago, Newberry Library 12, as well as
                        Eton 225 and the untraced manuscript of Gregory on Ezechiel.</note>
                  </msItem>
               </msContents>
               <history>
                  <origin>
                     <origDate when-custom="11XX" notBefore="1100" notAfter="1199" calendar="#gregorian">s. xii</origDate>
                  </origin>
                  <provenance><orgName role="fmo" key="mlgbOrg_458">Reading, Berkshire. Benedictine
                        abbey of Saint Mary the Virgin</orgName><p>Identifiable in the Reading
                        catalogues, secured by second folio in the refectory list.</p></provenance>
                  <provenance type="MLGB3_laterOwners">Sir Francis Englefield (fol. 138; d.
                     1596).</provenance>
                  <provenance type="MLGB3_laterOwners">'Liber Clementis burdett prec xxx s iiij d'
                     (fol. 94).</provenance>
                  <provenance type="MLGB3_laterOwners">Name of Reynoldes on fol. 1.</provenance>
                  <provenance type="MLGB3_laterOwners">?James Bowen: Quartich, Catalogue, 211 (1912)
                     says 'it does not bear the name of James Bowen but from the binding we know
                     that it belonged to him, along with other books from Reading abbey'. The volume
                     is now rebound (s. xx).</provenance>
                  <provenance type="MLGB3_laterOwners">Sir Thomas Phillipps (1792-1872), no.
                     3616.</provenance>
                  <provenance type="MLGB3_laterOwners">Sold at Sotheby's, March 1985, lot 356, to
                     Nichols.</provenance>
                  <provenance type="MLGB3_laterOwners">H. B. Weaver sale, Christies, 29 March 1898,
                     lot 322.</provenance>
                  <provenance type="MLGB3_laterOwners">Quartich, Catalogue, 180 (1898), no. 26; 211
                     (1902), no. 13.</provenance>
                  <provenance type="MLGB3_laterOwners">Given to Eton by Sir John Noble in November
                     1921.</provenance>
                  <provenance type="MLGB3_laterOwners"> </provenance>
               </history>
