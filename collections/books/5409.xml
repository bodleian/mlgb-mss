                  <msItem>
                     <title>R. Grosseteste, Epistole</title>
                     <note type="MLGB3_generalNotes">Barlow 49 fols. 4–56, and Oxford, CCC 245 are
                        parts of the manuscript entered in the medieval catalogue under N.16: bound
                        in Cottonian binding with a register of documents concerning Faringdon and a
                        cartulary of Holy Trinity Pontefract.</note>
                  </msItem>
               </msContents>
               <history>
                  <origin>
                     <origDate when-custom="14XX" notBefore="1400" notAfter="1499" calendar="#gregorian">s. xv</origDate>
                  </origin>
                  <provenance><orgName role="fmo" key="org_537">Syon, Middlesex. Bridgettine
                        abbey of St Saviour, St Mary the Virgin, and St Bridget</orgName><p>Barlow
                        49 fols. 4–56, and Oxford, Corpus Christi College, MS 245 are parts of the
                        manuscript entered in Betson's catalogue at N.16: bound in Cottonian binding
                        with a register of documents concerning Faringdon and a cartulary of Holy
                        Trinity Pontefract. This is part of the original volume as described in
                        Betson's catalogue as being on fols. 30–82. Oxford CCC 245, which is in the
                        same hand, was fols. 86–179 of the same volume. Barlow 49 is badly cut by
                        Robert Cotton's binder.</p></provenance>
                  <provenance type="MLGB3_laterOwners">? no. 110 in the John Dee's catalogue: note
                     that Dee's ladder mark is on fol. 1r of Oxford, Corpus Christi College, MS
                     145.</provenance>
                  <provenance type="MLGB3_laterOwners">Robert Cotton (fol. 4r).</provenance>
                  <provenance type="MLGB3_laterOwners">Dr John Prideaux.</provenance>
                  <provenance type="MLGB3_laterOwners">Thomas Barlow.</provenance>
                  <provenance type="MLGB3_laterOwners"> </provenance>
               </history>
