               <history>
                  <origin>
                     <origDate when-custom="12XX" notBefore="1200" notAfter="1299" calendar="#gregorian">s. xiii</origDate>
                  </origin>
                  <provenance type="#e" source="4640"><orgName role="fmo" key="mlgbOrg_467">Robertsbridge, Sussex.
                        Cistercian abbey of St Mary the Virgin</orgName><p>'Hunc librum scripsit
                        frater Willelmus de Wodecherche, laicus quondam conversus Pontis Roberti
                        cuius anime in pace requiescat. amen' (fol. 228r).</p><p>'Liber sancte Marie
                        de Ponte Roberti. Qui eum abstulerit aut vendiderit et quolibet modo ab hac
                        domo alienaverit vel quamlibet eius partem absciderit, sit Anathema
                        Maranatha. Amen.' (fol. 228r).</p></provenance>
                  <provenance type="MLGB3_laterOwners">Dean and Canons of Windsor,
                     1612.</provenance>
               <provenance type="#b" source="5833"><orgName role="fmo" key="mlgbOrg_596">Windsor, Berkshire.
                        Royal collegiate chapel of St George</orgName><p>Medieval binding in the
                        style used at St George's. A label once on backboard secured by nine nails;
                        above this is remains of a title with note of 2o folio 'de fratris' (MS has
                        'de factis') of s. xv, and above this again an older title "libri beati
                        Augustini". The same inscription also on the spine.</p><p>Pressmark "B G[?]"
                        at head of fol. 1r.</p><q type="pressmark">BG (?)</q></provenance>
               </history>
