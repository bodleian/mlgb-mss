                  <msItem>
                     <title>Summa Raymundi cum apparatu</title>
                     <note type="MLGB3_generalNotes">No. 109 in James's list (Norfolk Archaeol. 19,
                        p. 104).</note>
                     <note type="MLGB3_generalNotes">"Precium xvi s'" (fol. 1r erased), and fol.
                        153v.</note>
                     <note type="MLGB3_generalNotes">Earlier in France: "Pengnault" (?), and paraph,
                        fol. 153v, s. xv.</note>
                     <note type="MLGB3_generalNotes">2o folio "de quibusdam".</note>
                     <note type="MLGB3_generalNotes">(fol. 343r) "Ista summa est [...] quicumque eam
                        furatus fuerit uel alienauerit aut celauerit anathema sit".</note>
                     <note type="MLGB3_generalNotes">Another inscr. on fol. 343r is illegible under
                        u. v. light except for "de" (2nd word), and probably "Parisiis" at
                        end.</note>
                  </msItem>
               </msContents>
