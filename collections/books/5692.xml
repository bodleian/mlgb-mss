                  <provenance type="#c" cert="low"><orgName role="fmo" key="mlgbOrg_586">Wigmore,
                        Herefordshire. Augustinian abbey of St James</orgName>
                        <p>Chronicle of Wigmore abbey, with genealogical tables and heraldic
                        bearings concerning the Mortimer family. Fols. 49–60 has a heraldry-marked
                        descent of the Mortimers of Wigmore, c. 1400, which steadily tracks the
                        family in its relation to the abbey, most particularly Edmund Mortimer (d.
                        1381), who was regarded as 'secundus fundator' of the
                     abbey.</p></provenance>
                  <provenance type="MLGB3_laterOwners">Earl de Grey and Lord Lucas, Wrest Park
                     (Hist. MSS. Com. Rep. 2 (1871), p. 6, no. 25).</provenance>
                  <provenance type="MLGB3_laterOwners">Lady Lucas sale 19 June 1922 lot 636 to
                     May.</provenance>
                  <provenance type="MLGB3_laterOwners">Sold Sotheby 13 Nov. 1922 lot 394 to
                     Aston.</provenance>
                  <provenance type="MLGB3_laterOwners">Sold Sotheby 20 Nov. 1923 lot 499 to
                     Grundherr.</provenance>
                  <provenance type="MLGB3_laterOwners">Sold Sotheby 25 March 1929 lot 206 to
                     Quaritch.</provenance>
                  <provenance type="MLGB3_laterOwners">Given to C. U. (1929) by Martin A.
                     Ryerson.</provenance>
               </history>
