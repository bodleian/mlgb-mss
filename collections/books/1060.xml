                     <msItem>
                        <locus>(fols. 1r--110r)</locus>
                        <title>Stephen Langton, De poenitentia sub persona Magdalenae; inc.:
                           "Miserator et misericors Ihesus Christus qui misericordias suas
                           mirificavit in terra querens quod perierat ..."</title>
                     </msItem>
                  </msItem>
