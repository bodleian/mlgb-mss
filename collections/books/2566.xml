               <physDesc>
                  <bindingDesc>
                     <binding>
                        <p>Medieval binding. Title <q>Exposicio Ieronimi Super Ecclesiasten Et
                           quedam Excepciones in Theolg.</q> (s. xiv?) in red on outside of first
                           board. <q>Ieronimus super eclesiasten cum aliis</q> on back-board near
                           top, and below it <q>d h</q>.</p>
                     </binding>
                  </bindingDesc>
               </physDesc>
               <history>
                  <origin> <origDate when-custom="11XX" notBefore="1100" notAfter="1199"
                     calendar="#gregorian">s. xii</origDate> </origin>
                  <provenance type="#e" source="2566"><orgName role="fmo" key="org_190">Ely,
                     Cambridgeshire. Benedictine abbey and (1109) cathedral priory of St Peter and
                     St Etheldreda</orgName><p><q>Iste liber per[...]sie eliensis</q> in large
                     letters at foot of fol. 1r (s. xv), and the Ely cross-mark in the outer margin
                     of fol. 1r, both erased but legible by ultra-violet light.</p><p>Pressmark <q>M
                     23</q> at top right corner of fol. 1r.</p><p> </p><q type="pressmark"
                     >M.23</q></provenance>
                  <provenance type="MLGB3_laterOwners">Inscription at foot of fol. 1r, erased.
                     Erased inscription begins <q>Ego [. . .]</q> on fol. 66v (end
                     flyleaf).</provenance>
                  <provenance type="#rejected"><orgName role="fmo" key="org_86">Bury St Edmunds,
                     Suffolk, Benedictine abbey of St Edmund, King and Martyr</orgName> <p>This
                     attribution was rejected in the second edition of Medieval Libraries of Great
                     Britain (1964), which did not change in the Supplement (1987). Neil Ker clearly
                     thought there was little to support this attribution; on the corresponding
                     index card, he wrote (and initialled) <q>No evidence</q>.</p></provenance>
                  <provenance type="#b"><orgName role="fmo" key="org_596">Windsor, Berkshire. Royal
                     collegiate chapel of St George</orgName><p>Medieval binding. Usual chain
                     mark.</p><p> </p></provenance>
                  <provenance type="MLGB3_laterOwners">Presented to the Bodleian by the Dean and
                     canons of Windsor in 1612.</provenance>
               </history>
