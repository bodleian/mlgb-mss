                  <textLang mainLang="la">Latin</textLang>
                  <msItem>
                     <title>Iohannes Cassianus, De institutis Egyptiorum cenobiorum</title>
                     <note type="MLGB3_generalNotes">Above the ex-libris is 'Johannes Cassianus. A.
                        de Institutis egipciorum cenobiorum. qui alio nomine dicitur collaciones
                        patrum libri xii', in same hand as the inscriptions above.</note>
                     <note type="MLGB3_generalNotes">2o folio: 'nullos. quorum'.</note>
                     <note type="MLGB3_generalNotes">Rebacked, but old leather covers and flyleaves
                        and pastedowns preserved.</note>
                     <note type="MLGB3_generalNotes">'Volumen 6tum' on flyleaf recto (s. xvii
                        ?).</note>
                     <note type="MLGB3_generalNotes">Central strap and pin now gone. Bosses (?) now
                        gone: cf. marks on no. 5 (3 nail marks at each corner).</note>
                  </msItem>
               </msContents>
               <history>
                  <origin>
                     <origDate when-custom="11XX" notBefore="1100" notAfter="1199" calendar="#gregorian">s. xii</origDate>
                  </origin>
                  <provenance type="#e b"><orgName role="fmo" key="org_137">Chester, Cheshire.
                        Franciscan convent</orgName><p>'De communitate Minorum cestrie de dono
                        conewey ministri' (verso of flyleaf).</p><p>'Iste est Liber fratris Rogeri
                        de Conewey' (fol. 98v).</p><p>The medieval binding and style of binding
                        furniture is the same on Gray's Inn, MSS 1–9, 11–12, and 23, identifiably
                        deriving from the same library.</p><p> </p><q type="pressmark">[Johannes
                        Cassianus A]</q></provenance>
                  <provenance type="MLGB3_laterOwners">The Bostock family of Tattenhall
                     (Cheshire).</provenance>
