                  <msItem>
                     <title>Beda</title>
                     <note type="MLGB3_generalNotes">A ribband is cut in the flyleaf near the
                        bottom, carrying the title in a s. xv/xvi hand: it may have been so arranged
                        in order to project from the front of the volume.</note>
                     <note type="MLGB3_generalNotes">The binding is covered boards, with head and
                        tail pieces and a fine clasp.</note>
                     <msItem>
                        <author>Bede</author>
                        <title>super Lucam</title>
                     </msItem>
                  </msItem>
               </msContents>
               <history>
                  <origin>
                     <origDate when-custom="11XX" notBefore="1100" notAfter="1199" calendar="#gregorian">s. xii</origDate>
                  </origin>
                  <provenance type="#e"><orgName role="fmo" key="mlgbOrg_458">Reading, Berkshire.
                        Benedictine abbey of Saint Mary the Virgin</orgName><p>Two inscriptions at
                        fol. 1v, a flyleaf: 'Beda super lucam' (s. xv), and 'Hic est liber . . .
                        [erased] Quem qui celaverit | vel fraudem de eo fecerit -- anathema sit.'
                        (s. xiii). The anathema is the same formula and probably the same hand,
                        punctuated similarly and in the same position on the page, as that in Royal
                        3 A.iv (q.v.).</p></provenance>
                  <provenance type="MLGB3_laterOwners">Thomas Fytton (fol. 2, s. xvi); perhaps T.
                     Fitton of Siddington (d. 1599).</provenance>
                  <provenance type="MLGB3_laterOwners">Philip Mainwaringe (fol. 2, s. xvii), of Over
                     Peover, Cheshire (d. 1649).</provenance>
                  <provenance type="MLGB3_laterOwners">Bookplate of Sir Henry Mainwaring, Bart. (d.
                     1797).</provenance>
                  <provenance type="MLGB3_laterOwners">Bought at Sotheby's, January / February
                     1873.</provenance>
               </history>
