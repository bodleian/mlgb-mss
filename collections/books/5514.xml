                  <textLang mainLang="la">Latin</textLang>
                  <msItem>
                     <title>Psalmi, etc.</title>
                     <note type="MLGB3_generalNotes">This manuscript is a fragment of 33 leaves,
                        beginning with quire 'n'.</note>
                     <note type="MLGB3_generalNotes">It was assigned in MLGB to St Albans, on the
                        basis of its list of martyrs, which begins with Alban, Amphibalus cum sociis
                        and Oswin. That designation was rejected and replaced in the Supplement: for
                        the reasons see also Fitzwilliam Museum Syndicate's Annual Report (1973), p.
                        12.</note>
                  </msItem>
               </msContents>
               <history>
                  <origin>
                     <origDate when-custom="138X/139X" notBefore="1380" notAfter="1399" calendar="#gregorian">s. xiv ex.</origDate>
                  </origin>
                  <provenance type="#l"><orgName role="fmo" key="mlgbOrg_558">Tynemouth,
                        Northumberland. Benedictine priory of St Mary the Virgin and St Oswin; cell
                        of St Albans</orgName><p>This manuscript and Fitzwilliam Museum 1-1973
                        once formed one volume. The latter (q.v.) shows special devotion to St
                        Oswin, and so the two parts comes from Tynemouth, a cell of St
                     Albans.</p></provenance>
                  <provenance type="MLGB3_laterOwners">'Edmund Dudley 1504' (erased, fol.
                     33).</provenance>
                  <provenance type="MLGB3_laterOwners">There is also an erased inscription at the
                     top of fol. 33v, with 'Beaumont' at the foot.</provenance>
                  <provenance type="MLGB3_laterOwners">Sold at Sotheby's, sale of 26 February--3
                     March 1900, lot 1190.</provenance>
                  <provenance type="MLGB3_laterOwners">Bought by the Fitzwilliam in 1910 for £30
                     from H. T. Wake. Fritchley, Derby.</provenance>
               </history>
