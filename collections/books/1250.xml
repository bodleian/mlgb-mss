                     </altIdentifier>
                  </msIdentifier>
                  <msContents>
                     <textLang mainLang="la">Latin</textLang>
                     <msItem>
                        <author key="person_3900">Ps. Methodius</author>
                        <note type="MLGB3_generalNotes"><ref
                              target="https://mlgb.bodleian.ox.ac.uk/catalog/book_6541">British
                              Library MS Royal 13 D. i</ref> and Cotton MS Otho D.viii fols.
                           174–233 were formerly one volume, as shown by <bibl>J. P. Carley and C.
                              G. C. Tite in <title>The Library</title>, 6th ser. 14 (1992),
                              94–9.</bibl></note>
                     </msItem>
                  </msContents>
                  <history>
                     <origin>
                        <origDate when-custom="13XX/14XX" notBefore="1300" notAfter="1499"
                           calendar="#gregorian">s. xiv/xv</origDate>
                     </origin>
                     <provenance><orgName role="fmo" key="org_750">London. Chantry library at St
                           Peter-upon-Cornhill</orgName><p>The manuscript was formerly one with <ref
                              target="https://mlgb.bodleian.ox.ac.uk/catalog/book_6541">British
                              Library, MS Royal 13 D. i</ref>, which has an ex libris for St
                           Peter's.</p></provenance>
                     <provenance type="MLGB3_laterOwners">King Henry VIII. The Westminster palace
                        inventory number '708' is on fol. 2r. It may have been removed for the king
                        by John Leland, who lived in the neighbouring parish and took notes from the
                        parish library at St Peter's (SC268). It was shelved at 819 in 1542 (H2.
                        819).</provenance>
                  </history>
