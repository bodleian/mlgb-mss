                  <msContents>
                     <textLang mainLang="la">Latin</textLang>
                     <msItem>
                        <title>Passionale sancti Ignacii Primum (Feb. 1-March 20, ending
                           imperfect)</title>
                     </msItem>
                  </msContents>
                  <history>
                     <origin>
                        <origDate when-custom="11XX" notBefore="1100" notAfter="1199"
                           calendar="#gregorian">s. xii</origDate>
                     </origin>
                     <provenance type="#s"><orgName role="fmo" key="org_4">Canterbury, Kent.
                           Benedictine cathedral priory of Holy Trinity or Christ
                           Church</orgName><p>Cotton MS Otho D.viii fols. 8–173, and <ref
                              target="https://mlgb.bodleian.ox.ac.uk/catalog/book_1173">Cambridge,
                              Trinity College, O. 2. 51, flyleaves</ref>, are fragments of one
                           volume.</p><p>The hand is recognisably that of Christ Church.</p><p>The
                           flyleaves bear the 13th-century title 'Passionale sancti Ignacii . primum',
                           which corresponds to the wording of an entry in the Eastry catalogue from
                           the cathedral.</p><p>End part of contents list (= items 18–26 in Otho
                           D.viii) on front flyleaf of Trinity, title on end flyleaf of
                           Trinity.</p><p>See Ancient Libraries, p. 52, no. 360.</p><note
                           type="MLGB3_medievalCatalogueNotes">Cat. 360</note></provenance>
                     <provenance type="MLGB3_laterOwners">Wm. Bowier (see CCCC 298, art. 19, extract
                        'ex quodam vetusto libro quondam ecclesie Cantuar. iam in manibus mri Bower.
                        Liber vocatur passionale S. Ignatii'.</provenance>
                  </history>
               </msPart>
               <msPart>
                  <msIdentifier>
                     <altIdentifier>
