               <physDesc>
                  <objectDesc>
                     <supportDesc>
                        <extent>The original Medieval Libraries of Great Britain index card
                           describes this as a book with 166 fols. MLGB3 (2009-2015) noted that the
                           first leaf was lost. For comparison, the Bibliothèque royale de Belgique
                              <ref target="https://uurl.kbr.be/bib/17067887">catalogue entry</ref>
                           gives the extent as iii + 253 + v.</extent>
                     </supportDesc>
                     <layoutDesc>
                        <layout>The index card gives the following information: 22 lines, 21 x 15
                           1/2 cm. However, MLGB3 (2009-2015) described the book as having 18 long
                           lines.</layout>
                     </layoutDesc>
                  </objectDesc>
                  <handDesc>
                     <handNote>Large square hand like lot 223.</handNote>
                  </handDesc>
                  <decoDesc>
                     <decoNote>See provenance for discussion of historiated borders.</decoNote>
                  </decoDesc>
               </physDesc>
               <history>
                  <origin>
                     <origPlace>England</origPlace>
                     <origDate when-custom="148X/149X" notBefore="1480" notAfter="1499"
                        calendar="#gregorian">s. xv ex.</origDate>
                  </origin>
                  <provenance type="#l"><orgName role="fmo" key="org_537">Syon, Middlesex.
                        Bridgettine abbey of St Saviour, St Mary the Virgin, and St
                        Bridget</orgName><p>Calendar of Bridgettine use. Bridget follows Anne in the
                        litany, which agrees exactly with that in the Bridgettine psalter. Prayers
                        at end have female forms. Seven illuminated borders contain the figure of a
                        kneeling un, wearing the Bridgettine habit, with a scroll <q>Dignare me
                           laudare te virgo sacrata da michi</q>.</p></provenance>
                  <provenance type="MLGB3_laterOwners"><persName role="fmo">Elynor
                        ffeteplace</persName>, fol. 258r.</provenance>
                  <provenance type="MLGB3_laterOwners">Bookplate of <persName role="fmo">Lord
                        Arundell of Wardour</persName>.</provenance>
                  <provenance type="MLGB3_laterOwners">Maggs October 1935. This was the last known
                     location recorded in the second edition of Medieval Libraries of Great Britain
                     (1964).</provenance>
                  <provenance type="MLGB3_laterOwners">Sotheby sale 11 July 1966, lot 224 (property
                     of <persName role="fmo">Lord Dalhousie</persName>).</provenance>
                  <provenance type="MLGB3_laterOwners">Maggs, Bulletin 5 (1967), item
                     9.</provenance>
                  <provenance type="MLGB3_laterOwners">Now Brussels, Bibliothèque royale de
                     Belgique, MS IV.481, as noted in the supplement to Medieval Libraries of Great
                     Britain (1987).</provenance>
               </history>
