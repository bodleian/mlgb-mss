               <physDesc>
                  <objectDesc>
                     <supportDesc>
                        <extent>17 leaves.</extent>
                        <foliation>Paginated in red chalk 377- in continuation of the numbering in
                           the William of Malmesbury (<ref
                              target="https://mlgb.bodleian.ox.ac.uk/catalog/book_6699">Princeton,
                              University Library, MS 159</ref>). According to a note by Phillipps
                           the hand is that of Geoffrey of Monmouth.</foliation>
                     </supportDesc>
                  </objectDesc>

               </physDesc>
               <history>
                  <origin>
                     <origDate when-custom="11XX/12XX" notBefore="1100" notAfter="1299"
                        calendar="#gregorian">s. xii/xiii</origDate>
                  </origin>
                  <provenance><orgName role="fmo" key="org_467">Robertsbridge, Sussex. Cistercian
                        abbey of St Mary the Virgin</orgName><p>The manuscript has long been
                        associated with <ref
                           target="https://mlgb.bodleian.ox.ac.uk/catalog/book_6698">National
                           Library of Wales MS 13210D</ref> (which contains an inscription for the
                        abbey) and <ref target="https://mlgb.bodleian.ox.ac.uk/catalog/book_6699"
                           >Princeton, University Library, MS 159</ref>. The books were still
                        together during John Parker's time, when they were listed as one volume, but
                        had been separated into discrete bindings by the time of their sale to
                        Thomas Phillipps in 1828.</p></provenance>
                  <provenance type="MLGB3_laterOwners"><persName role="fmo">Matthew
                        Parker</persName> (1504–1575), archbishop of Canterbury.</provenance>
                  <provenance type="MLGB3_laterOwners"><persName role="fmo">John Parker</persName>
                     (1548–1619), son of the archbishop; pawned by his son <persName role="fmo"
                        >Richard</persName>.</provenance>
                  <provenance type="MLGB3_laterOwners"><persName role="fmo">Richard
                        Stanley</persName>, grandson of <persName role="fmo">William
                        Stanley</persName>, master of Corpus Christi College, Cambridge from 1693–8,
                     by whom sold at Christie's, 10 March 1828, to:</provenance>
                  <provenance type="MLGB3_laterOwners"><persName role="fmo">Sir Thomas
                        Phillipps</persName>, baronet (1792–1872), collector. His
                     26642.</provenance>
                  <provenance type="MLGB3_laterOwners">Phillipps sale, Sotheby's, 25 November 1969,
                     lot 455, to William Dawson and Sons. This was the last known provenance
                     according to the supplement to Medieval Libraries of Great Britain (1987). The
                     corresponding Medieval Libraries of Great Britain index card gives the
                     following additional information: £3000 for an Irish collector. Thought to be
                     probably Sir John Galvin of Loughlins Town House, County Dublin.</provenance>
               </history>
