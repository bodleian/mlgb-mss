               <history>
                  <origin>
                     <origDate when-custom="12XX" notBefore="1200" notAfter="1299"
                        calendar="#gregorian">s. xiii</origDate>
                  </origin>
                  <provenance type="#e"><orgName role="fmo" key="org_219">Fountains, Yorkshire.
                        Cistercian abbey of St Mary the Virgin</orgName><p><q>Liber Sancte Marie de
                           fontibus ex dono dompni <persName role="fmo">Henrici de
                              Knarresburc</persName></q> (s. xiii); <q>Theca 2 in nov[is sc.
                           armariis] liber xxxvi. 36</q> (fol. 2v).</p><q type="pressmark">Th.2 in
                        nov. lib.36</q></provenance>
                  <provenance type="MLGB3_laterOwners"><persName role="fmo">Wm Ingilby</persName>
                     1645 (fol. 161v).</provenance>
                  <provenance type="MLGB3_laterOwners">Ingilby Sale 21 October 1920 (Sotheby lot 75)
                     Maggs, cat. 1921 (404) no. 11.</provenance>
                  <provenance type="MLGB3_laterOwners">Bought by A. <persName role="fmo">Chester
                        Beatty</persName> no. 37.</provenance>
                  <provenance type="MLGB3_laterOwners">Sold Chester Beatty Sale (Sotheby lot 10) 7
                     June 1932 to Viner (£50).</provenance>
                  <provenance type="MLGB3_laterOwners">Owned by <persName role="fmo">Henry
                        Vyner</persName> of Studley Royal and on loan to the Archives Department of
                     Leeds Public Libraries (referenced there VR 6106). Vyner was listed as the
                     current owner of this book -- along with four others from Fountains Abbey -- in
                     the second edition of Medieval Libraries of Great Britain (1964).</provenance>
                  <provenance type="MLGB3_laterOwners">Reported as untraced in the supplement to
                     Medieval Libraries of Great Britain (1987). At the time, it was known that the
                     other four Vyner books had been purchased by the British Museum. Compare
                     Additional MSS <ref target="https://mlgb.bodleian.ox.ac.uk/catalog/book_2882"
                        >62129</ref>, <ref target="https://mlgb.bodleian.ox.ac.uk/catalog/book_2883"
                        >62130</ref>, <ref target="https://mlgb.bodleian.ox.ac.uk/catalog/book_2881"
                        >62131</ref>, and <ref
                        target="https://mlgb.bodleian.ox.ac.uk/catalog/book_2885">62132A</ref>. Note
                     also that fragments of a missal formerly with Additional MS 62129 were
                     identified as pastedowns from Additional MS 62132A and are now Additional MS
                        <ref target="https://mlgb.bodleian.ox.ac.uk/catalog/book_9747"
                     >62132B</ref>.</provenance>
                  <provenance type="MLGB3_laterOwners">Traced to the Beinecke Library through the
                     Schoenberg Database of Manuscripts <ref
                        target="https://sdbm.library.upenn.edu/manuscripts/2639">SDBM_MS_2639</ref>.
                     'Purchased from Bernard Quaritch, Ltd., on the James Marshall and Marie-Louise
                     Osborn Fund, 2004' according to the Beinecke <ref
                        target="https://pre1600ms.beinecke.library.yale.edu/docs/pre1600.osborn.fa42.htm"
                        >catalogue entry</ref>. </provenance>
               </history>
