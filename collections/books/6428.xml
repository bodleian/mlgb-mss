               <msContents>
                  <textLang mainLang="la">Latin</textLang>
                  <msItem>
                     <title>Biblia</title>
                     <note type="MLGB3_generalNotes">First noted in the supplement to Medieval
                        Libraries of Great Britain (1987), at which time it was untraced.</note>
                  </msItem>
               </msContents>
               <history>
                  <origin>
                     <origDate calendar="#Gregorian" notBefore="1200" notAfter="1299">s.
                        xiii</origDate>
                  </origin>
                  <provenance type="#i"><orgName role="fmo" key="org_4">Canterbury, Kent.
                        Benedictine cathedral priory of Holy Trinity or Christ Church</orgName><p>At
                        fol. i, two inscriptions: the first being <q>Bibblia magistri <persName
                              role="fmo">Thome Trussell</persName>
                           <note type="editorial">[space]</note> Eccl[es]ie xpi cantuarie</q> (s.
                        xiv) and the later <q>Bibblia dompni Will[el]mi Lighfyld monachi eccl[esi]e
                           x. cant.</q> (s. xv/xvi). All but the first four words of the earlier
                        inscription have been erased but legible under U.V. light. The monk is
                        William Lychefeld, adm. 1510; cf. Searle, p. 194.</p></provenance>
                  <provenance type="MLGB3_laterOwners">Magister <persName role="fmo">Thomas
                        Trussel</persName>, Middlesex (1331) and Northamptonshire (1344). </provenance>
                  <provenance type="MLGB3_laterOwners"><q>Liber dompni William Cockes clerici</q>
                     (fol. i, s.xvi). </provenance>
                  <provenance type="MLGB3_laterOwners"><persName role="fmo">Henry Munster</persName>
                     (s.xix). </provenance>
                  <provenance type="MLGB3_laterOwners"><persName role="fmo">J.
                     Poyner</persName>.</provenance>
                  <provenance type="MLGB3_laterOwners">Sold at Sotheby's, 12 December 1967, lot 19
                     to Sanders, Oxford for £850, from whom it was bought by <persName role="fmo"
                        >Hon. C. A. Lennox-Boyd</persName>.</provenance>
                  <provenance type="MLGB3_laterOwners">Sold at Christie's, 9 December 1981, lot 231,
                     to <persName role="fmo">Heribert Tenschert</persName>, Rotthalmünster, from
                     whom it was bought by <persName role="fmo">Martin Schøyen</persName>. It was
                     no. 15 in his collection.</provenance>
                  <provenance type="MLGB3_laterOwners">Sold at Dreweatts, 10 July 2018, lot 81 (as
                     'The Canterbury "Trussel" Bible'), to Canterbury Cathedral.</provenance>
               </history>
