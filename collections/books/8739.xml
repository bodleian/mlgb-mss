                        <textLang mainLang="la">Latin</textLang>
                        <msItem>
                            <title>Missale</title>
                            <note>
                                <p>2o folio: credendo ut habundetis</p>
                                <p>Notes by Brightman are kept with the manuscript.</p>
                                <p>Fols. 162-177 all apparently a supply, since the text follows on
                                    directly from the early 13th century part.</p>
                                <p>Three sections:</p>
                                <p>[1] Fols. 1-134: 16 quires signed II-XII, then four unsigned (so
                                    the first quire is missing).</p>
                                <p>[2] Fols: 135-137: 3 leaves </p>
                                <p>[3] Fols. 138-161: 3 quires signed IX-XI (signatures erased).</p>
                                <p>This is followed by the supply leaves 162-177 (2 quires).</p>
                            </note>
                            <note/>
                        </msItem>
                    </msContents>
                    <physDesc>
                        <bindingDesc>
                            <binding>
                                <p>Medieval binding of white leather over boards with chemise over.
                                    Central stap and pin now missing.</p>
                            </binding>
                        </bindingDesc>
                    </physDesc>
                    <history>
                        <origin>
                            <origDate calendar="Gregorian" notBefore="1200" notAfter="1499">s. xiii
                                in (fols. 1-161) - s. xv (fols. 162-177)</origDate>
                        </origin>
                        <provenance type="#e"><orgName role="fmo" key="org_840">Exeter, Devon.
                                Chapel of St Anne (in parish of St Sidwell)</orgName>
                            <p><q>Dominus <persName key="person_3964" role="dnr">Johannes
                                        Hyotte</persName> Anniuellarius in Ecclesia Cath' Exon'
                                    contulit hunc librum missale deo et capelle sancte anne in
                                    parochia sancte satiuole situat' ob honore sancte anne et beati
                                    Johannes [sic] Euangeliste ibidem pro celebrant' quamdiu
                                    duraverit remansurum</q> (fol. 169). </p><p>(? This is an out of
                                date and fragmentary Exeter service book, completed (more or less)
                                for John Hyolte, who then gave it to St Anne's Chapel).</p>
                            <p>The index card has an incomplete note, indicating that one J. Hyolt
                                owned Magdalen College [...] and Royal [...]. </p></provenance>
                    </history>
