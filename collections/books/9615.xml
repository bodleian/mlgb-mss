                  <msItem n="2">
                     <title>Chronicle from Adam 'desinens in regnum Assyriorum'</title>
                     <incipit>Considerans historie sacre prolixatem</incipit>
                     <note>Incipit as Peter of Poitiers.</note>
                  </msItem>
                  <msItem n="3">
                     <title>Chronicon ab Adamo ad Henricum VI</title>
                     <incipit><note type="editorial">[Preface] </note>Cuilibet principi Congruum
                        utile et honestum est genealogie sue seriem cognoscere</incipit>
                     <note>Contained at the end notes on the Archbishop of Canterbury to Thomas
                        Bouchier and on the abbots of Osney to John Walton. The Osney notes are
                        printed by H. E. Salter, 'The Annals of the Abbots of Oseney', in
                           <title>English Historical Review 33</title> (1918) 498.</note>
                  </msItem>
               </msContents>
