                  <msItem>
                     <title source="1391">Collectio decem partium (expansion of Ivo of Chartres, Panormia)</title>
                     <note type="MLGB3_generalNotes" source="1391">This is seemingly a revised version of the
                        Panormia, by an unknown author, made about 1130, and is described by M. Paul
                        Fournier as “Collection en dix parties', see Les Collections Canoniques
                        attribuées à Yves de Chartres, Bibliothèque de l'École des Chartes (1897),
                        p. 147. </note>
                  <title source="6793">Collectio decem partium</title>
                     <msItem source="6793">
                        <title>Revised version of the text.</title>
                     </msItem>
                  </msItem>
               </msContents>
               <history>
                  <origin>
                     <origDate when-custom="11XX" notBefore="1100" notAfter="1199" calendar="#gregorian">s. xii</origDate>
                  </origin>
                  <provenance type="#s" cert="low" source="1391"><orgName role="fmo" key="mlgbOrg_4">Canterbury, Kent.
                        Benedictine cathedral priory of Holy Trinity or Christ Church</orgName><p>From Christ Church, canterbury. No mark remains, but the
                        evidence of the script is strong; cf. also Parker's note on fol. 1r, which
                        suggests a connexion with Canterbury. </p><p>T.A.M. Bishop (Trans. Cambridge
                        Bibliogr. Society 1, p. 438) thought that the script was evidence that the
                        copy had been written at St Augustine's, Canterbury.</p></provenance>
               <provenance type="#s" cert="low" source="6793"><orgName role="fmo" key="mlgbOrg_122">Canterbury, Kent.
                        Benedictine abbey of St Augustine (originally of St Peter and St Paul)</orgName><p>For evidence that the manuscript was written at St Augustine's,
                        see T. A. M. Bishop, 'Notes on Cambridge Manuscripts', Transactions of the
                        Cambridge Bibliographical Society, 1 (1953), pp. 432-41 at p.
                     438.</p></provenance>
               </history>
