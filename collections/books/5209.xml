                  <bindingDesc>
                     <binding contemporary="true">
                        <p><note type="MLGB3_generalNotes">Medieval binding. On the inside of the
                              front cover is <q>Liber Cartus. Schene Iesu Bethleme Greneholgh Monke
                                 Professus.</q></note></p>
                     </binding>
                  </bindingDesc>
