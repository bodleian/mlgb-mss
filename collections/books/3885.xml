                  <msItem>
                     <title>Chronicon abbatie de Parco Lude</title>
                     <note type="MLGB3_generalNotes">Partially printed by E. Venables,
                           <title>Chronicon abbatiae de Parco Lude</title>, Lincoln Record Society 1
                        (1891), siglum V; identification of this manuscript, now in a public
                        collection, as V was made by T. Russell Smith in <title>The Library</title>,
                        7th ser. 21 (2020), 98–101.</note>
                  </msItem>
               </msContents>
               <history>
                  <origin>
                     <origDate when-custom="14XX" notBefore="1400" notAfter="1499"
                        calendar="#gregorian">s. xv</origDate>
                  </origin>
                  <provenance type="#c"><orgName role="fmo" key="org_352">Louth Park, Lincolnshire.
                        Cistercian abbey of St Mary the Virgin</orgName><p>Provenance inferred from
                        contents: Chronicon abbatie de Parco Lude.</p></provenance>
                  <provenance type="MLGB3_laterOwners">Owned by <persName role="fmo">Henry
                        Harrod</persName>, antiquary, at his death on 24 January 1871. Acquired by
                        <persName role="fmo">William Allison</persName> of Louth, 1891, described in
                     the Lincs Rec. Soc. edition of that year as owner of the abbey
                     site.</provenance>
                  <provenance type="MLGB3_laterOwners">March 1940 in possession of Mr J. N. Allison,
                     129 Dorset Road, Bexhill on Sea; but owned by his nephew Major <persName
                        role="fmo">W. W. Allison</persName>, Flackwell Heath (Bucks).</provenance>
                  <provenance type="MLGB3_laterOwners">In March 1962 in possession of <persName
                        role="fmo">Mr R. W. Allison</persName>, Two Trees Links Rd., but owned by
                     his father Brigadier W. W. Allison, Lambricks, Tregoney, Truro, Cornwall.
                     Allison was listed as the owner in the second edition of Medieval Libraries of
                     Great Britain (1964). The book had become untraced by the time that the
                     supplement to Medieval Libraries of Great Britain (1987) was
                     published.</provenance>
                  <provenance type="MLGB3_laterOwners">20 October 1991, bought by <persName
                        role="fmo">Martin Schøyen</persName> through Jeremy Griffiths, becoming Oslo
                     and London, Schøyen Collection, MS 1373.</provenance>
                  <provenance type="MLGB3_laterOwners">14 April 2005, purchased from the Schøyen
                     Collection through Bernard Quaritch Ltd, becoming New Haven, Yale University,
                     MS Osbern fa44.</provenance>
               </history>
