                  <textLang mainLang="la">Latin</textLang>
                  <msItem>
                     <author key="person_352">Augustinus</author>
                     <title key="work_984">in Psalmos 101–150</title>
                     <note type="MLGB3_generalNotes">Very fine MS.</note>
                     <note type="MLGB3_generalNotes">Ker seems to have been undecided about the
                        attribution for the pressmark B. IIII in red at top of fol. 1. On the index
                        card for the Windsor provenance (which he originally wrote in black ink), he
                        later returned and added the following note in pencil: "(cf. B VIII in red
                        'on the margin' of Trinity Cambridge MS 1442 [i.e. O.9.30] and see if <ref
                           target="https://mlgb.bodleian.ox.ac.uk/catalog/book_5816">Cambridge,
                           University Library, MS Dd.1.7,8</ref> are of the set)"</note>
                  </msItem>
               </msContents>
               <physDesc>
                  <bindingDesc>
                     <binding contemporary="true">
                        <p>Medieval binding (see further discussion below).</p>
                     </binding>
                  </bindingDesc>
               </physDesc>
               <history>
                  <origin>
                     <origDate when-custom="110X/111X" notBefore="1100" notAfter="1119"
                        calendar="#gregorian">s. xii in.</origDate>
                  </origin>
                  <provenance cert="low"><orgName role="fmo" key="org_205">Eynsham, Oxfordshire.
                        Benedictine abbey of St Mary the Virgin, St Benedict and All
                        Saints</orgName><p>"B. IIII" in red, middle top of fol. 1r middle top of
                        first leaf of text, apparently in the same hand as in <ref
                           target="https://mlgb.bodleian.ox.ac.uk/catalog/book_2831">Oxford,
                           Bodleian Library, MS Laud Lat. 31</ref>.</p> Marginalia perhaps in the
                     same hand s. xiv as in <ref
                        target="https://mlgb.bodleian.ox.ac.uk/catalog/book_2831">MS Laud lat.
                        31</ref>: compare for example MS Bodley 269, fol. 217r and MS Laud Lat. 31,
                     fol. 214r.<q type="pressmark">B.IIII</q>
                  </provenance>
                  <provenance><orgName role="fmo" key="org_596">Windsor, Berkshire. Royal collegiate
                        chapel of St George</orgName><p>"SV" on fol. i recto, formerly pastedown.<q
                           type="pressmark">SV</q> Medieval binding generally like <ref
                           target="https://mlgb.bodleian.ox.ac.uk/catalog/book_5839">Oxford,
                           Bodleian Library, MS Bodley 192</ref>. Usual chainmark.</p></provenance>
                  <provenance type="MLGB3_laterOwners"><q>C[aucio ...] Roberti [...] exposita in
                        Cista de [...] et habet vnum Supplementum [...]</q> on verso of last
                     leaf.</provenance>
