               <physDesc>
                  <bindingDesc>
                     <binding notBefore="1949">
                        <p>According to the Medieval Libraries of Great Britain index card (written
                           by Neil Ker): "Very decayed medieval binding, about to be redone by
                           Sangorski May 1949."</p>
                        <p>According to the Schoenberg Database of Manuscripts <ref
                              target="https://sdbm.library.upenn.edu/entries/69568"
                           >SDBM_69568</ref>: "Natural sheep over wooden boards, remains of original
                           doeskin sides preserved".</p>
                     </binding>
                  </bindingDesc>
               </physDesc>
               <history>
                  <origin>
                     <origDate when-custom="140X/141X" notBefore="1400" notAfter="1419"
                        calendar="#gregorian">s. xv in</origDate>
                  </origin>
                  <provenance type="#i"><orgName role="fmo" key="org_86">Bury St Edmunds, Suffolk.
                        Benedictine abbey of St Edmund, King and Martyr</orgName><p><q>Iste liber
                           constat Johanni <note type="editorial">(canc)</note> Thome Hyngham
                           monachi diui Edmundi de Bury</q> (the first part of the addition is over
                        erasure)</p></provenance>
                  <provenance type="MLGB3_laterOwners">Sale at Christie's, 25 April 1949, lot 16, to
                     Maggs Bros (Books from the library of the hospital of <persName role="fmo">Sir
                        William Turner</persName> at Kirkleatham, Yorkshire, founded 1676). This was
                     the last known provenance according to the second edition of Medieval Libraries
                     of Great Britain (1964).</provenance>
                  <provenance type="MLGB3_laterOwners">[Unverified] This manuscript is presumably
                     identical with Quaritch catalogue 897 (1969), no. 51. Compare Schoenberg
                     Database of Manuscripts <ref
                        target="https://sdbm.library.upenn.edu/entries/69568"
                     >SDBM_69568</ref>.</provenance>
                  <provenance type="MLGB3_laterOwners">In the supplement to Medieval Libraries of
                     Great Britain (1987), the location was changed from untraced to Mr H. C.
                     Pratt.</provenance>
               </history>
