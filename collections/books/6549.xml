                  <textLang mainLang="la">Latin</textLang>
                  <msItem>
                     <title>Missale ad usum Londoniensis (fragment)</title>
                     <note>Calendar (May-August). <q>Sancti Ælberti regis et matiris</q> in blue (20
                        May).</note>
                     <note>See F. C. Eeles, 'Part of the kalendar of a XIIIth-century service book
                        once in the church of Writtle', <title>Transactions of the Essex
                           Archaeological Society</title>, new series 25 (1955), 68-79.</note>
                     <note>For a description, see <bibl>Neil R. Ker, <title>Medieval Manuscripts in
                              British Libraries: Volume 3, Lampeter-Oxford </title> (Oxford, 1983),
                           pp. 212-13.</bibl></note>
                  </msItem>
               </msContents>
               <history>
                  <origin>
                     <origDate when-custom="12XX" notBefore="1200" notAfter="1299"
                        calendar="#gregorian">s. xiii</origDate>
                  </origin>
                  <provenance type="#l" cert="low"><orgName role="fmo" key="org_732">Writtle, Essex.
                        Church or hospital of All Saints</orgName><p>A bifolium assigned to Writtle
                        on the basis of an obit for <persName>Iacobus de Civitate Sancti Angeli (d.
                           1348)</persName>, master of the church: <q>Obitus fratrum Jacobi de
                           ciuitate sancti angeli custodis ecclesie omnium sanctorum de Writele anno
                           domini 1348 cuius anime propricietur deus</q> (at 20 May, lined through).
                        See further at <bibl>Nigel Ramsay and James Willoughby, <title>Hospitals,
                              towns, and the professions</title> (London, 2009), pp.
                        455–6.</bibl></p></provenance>
                  <provenance type="MLGB3_LaterOwners">Tregaskis, Catalogue 1003 (1932), no.
