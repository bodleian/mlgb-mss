               <history>
                  <origin>
                     <origDate when-custom="1201/1400" notBefore="1201" notAfter="1400" calendar="#gregorian">s. xiii, xiv</origDate>
                  </origin>
                  <provenance type="#b" cert="low"><orgName role="fmo" key="org_607">York, Yorkshire.
                        Cathedral church of St Peter</orgName><p>On the third leaf (s. xv): 'Liber
                        ecclesie metropolitane beati Petri Ebor [erased]', and title, 'Ex dono
                        magistri Iohannis Neuton Thesaurarii eiusdem'. He was master of Peterhouse
                        1381–95, and a donor to their library.</p><p>'Augustinus de verbis domini
                        et apostoli' is listed as one of John Newton's gifts in his testament. This
                        appears to be an extraneous leaf from another manuscript.</p><p>No volume
                        with the contents of this one is listed in Newton's
                     bequest.</p></provenance>
                  <provenance type="MLGB3_laterOwners">'Liber Iohannis Armytagi' (s.
                     xvi).</provenance>
                  <provenance type="MLGB3_laterOwners">Given to Trinity by Thomas Nevile, dean of
                     Canterbury (c. 1548–1615).</provenance>
               </history>
